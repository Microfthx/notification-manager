# Backend runtime paths. Defaults work when starting from this repository.
PORT=4000
NOTIFICATION_MANAGER_UID=1000
NOTIFICATION_MANAGER_GID=1000
# PROJECT_ROOT=/absolute/path/to/notification-manager
# BOTS_ROOT=/absolute/path/to/notification-manager/bots
# LOGS_ROOT=/absolute/path/to/notification-manager/logs
# AIO_PROJECT_ROOT=/absolute/path/to/aio-dynamic-push-master
# AIO_CONFIG_TEMPLATE_PATH=/absolute/path/to/aio-dynamic-push-master/config copy.yml
# AIO_PYTHON_BIN=/absolute/path/to/python
# WEIBO_SESSION_ENABLED=true
# WEIBO_SESSION_INTERVAL_SECONDS=14400
# WEIBO_SESSION_INITIAL_DELAY_SECONDS=60
# WEIBO_PROFILE_ROOT=/absolute/path/to/notification-manager/data/weibo-profile

# Use this when the frontend is served separately without its development proxy.
# REACT_APP_API_BASE_URL=http://localhost:4000/api
# API_PROXY_TARGET=http://localhost:4000
# Container and bot log timezone.
TZ=Asia/Shanghai
BOT_AUTO_START_INTERVAL_SECONDS=15
